# ==================================
# 全局通用 (Global)
# ==================================
# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器/IDE 配置文件
.idea/
.vscode/
*.swp
*.swo

# 日志文件
*.log

# ==================================
# 后端 Python (Backend)
# ==================================
# 字节码缓存 (Python 运行时自动生成，不需要上传)
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境 (非常重要，不要上传几个G的依赖包)
# 匹配根目录或 backend 目录下的虚拟环境文件夹
.venv/
venv/
env/
ENV/

# 环境变量文件 (包含敏感信息)
.env

# 【关键】本地数据文件
# 防止本地测试的数据覆盖服务器上的正式数据
# 代码里已经写了“如果文件不存在则自动创建”，所以这里放心忽略
backend/data/data.json

# 如果你以后加了 pytest 测试
.pytest_cache/
.coverage
htmlcov/

# ==================================
# 前端 Node/React (Frontend)
# ==================================
# 依赖包 (体积巨大，服务器端通过 npm install 生成)
node_modules/

# 构建输出 (npm run build 生成的静态文件，不需要源码管理)
dist/
build/

# 各种包管理器的调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端本地环境变量
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite 缓存
node_modules/.vite/